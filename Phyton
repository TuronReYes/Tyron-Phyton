    # ---------------------------------------------------------------

    def font(self, size, weight="normal", kind="ui", slant="roman"):
        key = (size, weight, kind, slant)
        if key not in self._fonts:
            self._fonts[key] = ctk.CTkFont(family=FONT_FAMILIES[kind], size=size,
                                           weight=weight, slant=slant)
        return self._fonts[key]

    def _scaling(self):
        try:
            return ctk.ScalingTracker.get_widget_scaling(self)
        except Exception:
            return 1.0

    def _center_window(self, width, height):
        self.update_idletasks()
        x = max(0, (self.winfo_screenwidth() - width) // 2)
        y = max(0, (self.winfo_screenheight() - height) // 3)
        self.geometry(f"{width}x{height}+{x}+{y}")

    def _fade_in(self, alpha=0.0):
        try:
            alpha = min(1.0, alpha + 0.08)
            self.attributes("-alpha", alpha)
            if alpha < 1.0:
                self.after(15, lambda: self._fade_in(alpha))
        except tk.TclError:
            pass

    def run_in_background(self, work, on_done):
        """Run slow network work off the UI thread, then call on_done(value, error) on the UI thread."""
        result = {}

        def target():
            try:
                result["value"] = work()
            except Exception as exc:
                result["error"] = exc

        worker = threading.Thread(target=target, daemon=True)
        worker.start()

        def poll():
            if worker.is_alive():
                self.after(120, poll)
            else:
                on_done(result.get("value"), result.get("error"))

        self.after(120, poll)

    def _reset_root(self):
