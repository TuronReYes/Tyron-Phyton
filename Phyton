        self._nav_section(sidebar, "LESSONS")
        for index in range(TOTAL_LESSONS):
            self._nav_button(sidebar, f"lesson-{index}", lambda i=index: self.show_lesson(i))
        self._nav_section(sidebar, "REWARDS")
        self._nav_button(sidebar, "certificate", self.show_certificate)

    def _nav_section(self, parent, title):
        ctk.CTkLabel(parent, text=title, font=self.font(10, "bold"), text_color=C["muted"],
                     anchor="w", height=18).pack(fill="x", padx=26, pady=(12, 4))

    def _nav_button(self, parent, key, command):
        button = ctk.CTkButton(parent, text="", command=command, height=36, corner_radius=10,
                               anchor="w", fg_color="transparent", hover_color=C["card"],
                               text_color=C["muted"], font=self.font(13))
        button.pack(fill="x", padx=14, pady=1)
        self.nav_buttons[key] = button

    def _nav_label(self, key):
        if key == "dashboard":
            return "◆   Dashboard", C["text_soft"]
        if key == "certificate":
            if self.quest.passed == TOTAL_LESSONS:
                return "★   Certificate", C["accent"]
            return f"★   Certificate  ·  {self.quest.passed}/7", C["muted"]
        index = int(key.split("-")[1])
        title = LESSONS[index]["title"]
        if self.quest.is_passed(index):
            return f"✓   {title}", C["success"]
        return f"{index + 1}    {title}", C["text_soft"]

    def _build_header(self, parent):
        header = ctk.CTkFrame(parent, fg_color="transparent")
        header.grid(row=0, column=0, sticky="ew", padx=(28, 22), pady=(20, 10))
        header.grid_columnconfigure(0, weight=1)

        titles = ctk.CTkFrame(header, fg_color="transparent")
        titles.grid(row=0, column=0, sticky="w")
        self.page_title = ctk.CTkLabel(titles, text="", font=self.font(24, "bold"),
                                       text_color=C["text"], anchor="w", height=32)
        self.page_title.pack(anchor="w")
        self.page_subtitle = ctk.CTkLabel(titles, text="", font=self.font(13),
                                          text_color=C["muted"], anchor="w", height=20)
        self.page_subtitle.pack(anchor="w")

        stats = self._card(header, fg=C["surface"], radius=14)
        stats.grid(row=0, column=1, sticky="e")
        rank_box = ctk.CTkFrame(stats, fg_color="transparent")
        rank_box.pack(side="left", padx=(18, 14), pady=10)
        ctk.CTkLabel(rank_box, text="RANK", font=self.font(10, "bold"), text_color=C["muted"],
                     height=14, anchor="w").pack(anchor="w")
        self.rank_label = ctk.CTkLabel(rank_box, text="", font=self.font(15, "bold"),
                                       text_color=C["accent"], height=22, anchor="w")
        self.rank_label.pack(anchor="w")

        ctk.CTkFrame(stats, fg_color=C["border"], width=1, height=36).pack(side="left", pady=10)

        progress_box = ctk.CTkFrame(stats, fg_color="transparent")
        progress_box.pack(side="left", padx=(14, 18), pady=10)
        self.progress_label = ctk.CTkLabel(progress_box, text="", font=self.font(10, "bold"),
                                           text_color=C["muted"], height=14, anchor="w")
        self.progress_label.pack(anchor="w")
        self.progress = ctk.CTkProgressBar(progress_box, width=180, height=8, corner_radius=4,
                                           fg_color=C["border"], progress_color=C["success"])
        self.progress.set(0)
        self.progress.pack(anchor="w", pady=(8, 0))

    def refresh_chrome(self):
        for key, button in self.nav_buttons.items():
            text, color = self._nav_label(key)
            active = key == self.current_key
            button.configure(text=text, text_color=C["text"] if active else color,
                             fg_color=C["card"] if active else "transparent",
                             font=self.font(13, "bold" if active else "normal"))
        self.rank_label.configure(text=self.quest.rank)
        self.progress_label.configure(text=f"PROGRESS  ·  {self.quest.passed} / {TOTAL_LESSONS} PASSED")
        self._animate_progress(self.quest.passed / TOTAL_LESSONS)

    def _animate_progress(self, target, step=0, start=None):
        if start is None:
            start = self.progress.get()
        steps = 14
        eased = 1 - (1 - step / steps) ** 3
        try:
            self.progress.set(start + (target - start) * eased)
        except tk.TclError:
            return
        if step < steps:
            self.after(16, lambda: self._animate_progress(target, step + 1, start))

    def _show_page(self, key, title, subtitle, builder):
        self.current_key = key
        self.page_title.configure(text=title)
        self.page_subtitle.configure(text=subtitle)
        if self.scroll is not None:
            self.scroll.destroy()
        self._wrap_targets = []
        self.scroll = ctk.CTkScrollableFrame(self.body, fg_color=C["bg"], corner_radius=0,
                                             scrollbar_button_color=C["border"],
                                             scrollbar_button_hover_color=C["muted"])
        self.scroll.pack(fill="both", expand=True)
        page = ctk.CTkFrame(self.scroll, fg_color="transparent")
        page.pack(fill="x", padx=(28, 16), pady=(6, 36))
        builder(page)
        self.refresh_chrome()
        self.after(20, lambda: self._update_wrap(self.body.winfo_width()))

