    return [("RANK", rank),
            ("LESSONS", f"{passed} of {total} passed"),
            ("ISSUED", issued.strftime("%B %d, %Y"))]


def certificate_filename(player):
    safe = "".join(ch for ch in player if ch.isalnum() or ch in " _-").strip()
    safe = "_".join(safe.split()) or "Player"
    return f"Python_Journey_Certificate_{safe}.pdf"


