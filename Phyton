def age_category(age):
    if age < 0 or age > 100:
        return "Invalid input"
    elif age <= 12:
        return "Category: Child"
    elif age <= 19:
        return "Category: Teenager"
    elif age <= 59:
        return "Category: Adult"
    else:
        return "Category: Senior Citizen"


