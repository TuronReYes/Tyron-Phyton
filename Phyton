def gmail_login(address, password):
    """Original App Password login (kept as-is)."""
    try:
        server = smtplib.SMTP_SSL("smtp.gmail.com", 465, timeout=20)
        server.login(address, password)
        return server
    except smtplib.SMTPAuthenticationError:
        return "wrong"
    except Exception:
        pass   # port 465 did not work, so try the other way below
    try:
        server = smtplib.SMTP("smtp.gmail.com", 587, timeout=20)
        server.starttls()
        server.login(address, password)
        return server
    except smtplib.SMTPAuthenticationError:
        return "wrong"
    except Exception:
        return "offline"


def build_certificate_email(sender, recipient, name, pdf_bytes, filename):
    """Same subject and body text as before, now with the PDF attached."""
    mail = EmailMessage()
    mail["Subject"] = "Your Python Quest Certificate"
    mail["From"] = sender
    mail["To"] = recipient
    mail.set_content(certificate_email_body(name))
    mail.add_attachment(pdf_bytes, maintype="application", subtype="pdf", filename=filename)
    return mail


def send_certificate(address, password, name, pdf_bytes, filename):
    """App Password (SMTP) flow. Returns (sent, message). 'sent' is True only if Gmail accepted it."""
    server = gmail_login(address, password)
    if server == "wrong":
        return False, "Login failed. Check your App Password."
    if server == "offline":
        return False, "Could not reach Gmail. Check your internet."
    mail = build_certificate_email(address, address, name, pdf_bytes, filename)
    try:
        server.send_message(mail)
    except Exception as exc:
        return False, f"Gmail did not accept the message ({exc})."
    finally:
        try:
            server.quit()
        except Exception:
            pass
    return True, "Certificate PDF sent! Check your inbox (and the Spam folder)."


def find_client_secret():
    """Look for the OAuth client file you downloaded from Google Cloud. Nothing is hardcoded."""
    candidates = [os.environ.get("PYTHON_JOURNEY_CLIENT_SECRET", ""),
                  str(CLIENT_SECRET_FILE),
                  str(Path.cwd() / "credentials.json"),
                  str(Path(__file__).resolve().parent / "credentials.json")]
    for path in candidates:
        if path and Path(path).is_file():
            return path
    return None


def gmail_api_send(address, name, pdf_bytes, filename, client_secret_path):
    """Gmail API + OAuth 2.0 flow. Returns (sent, message). Opens the browser the first time only."""
    try:
        from google.auth.transport.requests import Request
        from google.oauth2.credentials import Credentials
        from google_auth_oauthlib.flow import InstalledAppFlow
        from googleapiclient.discovery import build
        from googleapiclient.errors import HttpError
    except ImportError:
        return False, ("Gmail API libraries are missing. Run:  pip install google-api-python-client "
                       "google-auth-oauthlib google-auth-httplib2")
    try:
        creds = None
        if TOKEN_FILE.is_file():
            try:
                creds = Credentials.from_authorized_user_file(str(TOKEN_FILE), GMAIL_SCOPES)
            except Exception:
                creds = None
        if creds and creds.expired and creds.refresh_token:
            try:
                creds.refresh(Request())
            except Exception:
                creds = None
        if not creds or not creds.valid:
            flow = InstalledAppFlow.from_client_secrets_file(client_secret_path, GMAIL_SCOPES)
            creds = flow.run_local_server(port=0, prompt="consent")
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        TOKEN_FILE.write_text(creds.to_json(), encoding="utf-8")
        try:
            os.chmod(TOKEN_FILE, 0o600)
        except OSError:
            pass

        service = build("gmail", "v1", credentials=creds, cache_discovery=False)
        # "me" is whichever Google account signed in; the mail is addressed to the registered email.
        mail = build_certificate_email("me", address, name, pdf_bytes, filename)
        raw = base64.urlsafe_b64encode(mail.as_bytes()).decode()
        response = service.users().messages().send(userId="me", body={"raw": raw}).execute()
        if not response.get("id"):
            return False, "Gmail did not confirm the message."
    except HttpError as exc:
        return False, f"Gmail API error: {getattr(exc, 'reason', exc)}"
    except Exception as exc:
        return False, f"Could not send through Gmail ({exc})."
    return True, "Certificate PDF sent! Check your inbox (and the Spam folder)."


