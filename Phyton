        self._show_page(f"lesson-{index}", f"Lesson {index + 1}: {lesson['title']}", lesson["summary"],
                        lambda page: self._build_lesson(page, index))

    def _build_lesson(self, page, index):
        lesson = LESSONS[index]

        meta = ctk.CTkFrame(page, fg_color="transparent")
        meta.pack(fill="x", pady=(0, 10))
        self._pill(meta, f"LESSON {index + 1} OF {TOTAL_LESSONS}", C["primary_soft"],
