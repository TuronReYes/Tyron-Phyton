        content = self._card(page, radius=20)
        content.pack(fill="x")
        inner = ctk.CTkFrame(content, fg_color="transparent")
        inner.pack(fill="x", padx=30, pady=26)
        for position, block in enumerate(lesson["blocks"]):
            self._render_block(inner, block, first=position == 0)

        bar = self._card(page, fg=C["surface"], radius=18)
        bar.pack(fill="x", pady=(16, 0))
        bar.grid_columnconfigure(0, weight=1)
