    def _set_form_busy(self, busy):
        state = "disabled" if busy else "normal"
        self.start_button.configure(state=state, text="Checking your login..." if busy else "Start Journey")
        self.skip_button.configure(state=state)

    def _on_start(self, skip_email):
        if str(self.start_button.cget("state")) == "disabled":
            return
        name = self.name_entry.get().strip()
        if not name:
            self._set_form_status("Please enter your name to begin.")
            self.name_entry.focus_set()
            return

        email = "" if skip_email else self.email_entry.get().strip()
        if email == "":
            self._begin(name, "", "")
            return
        if "@" not in email or "." not in email.split("@")[-1]:
            self._set_form_status("That does not look like a valid Gmail address.")
            return

        app_password = self.password_entry.get().replace(" ", "")
        if app_password == "":
            # No App Password: the certificate will be sent through the Gmail API (OAuth 2.0).
            self._begin(name, email, "", oauth=True)
            return
        if len(app_password) != 16:
            self._set_form_status("An App Password has exactly 16 letters. Try again, or leave it empty "
                                  "to use Google sign-in.")
            self.password_entry.focus_set()
            return

        self._set_form_status("Checking your login...", "info")
        self._set_form_busy(True)

        def work():
            result = gmail_login(email, app_password)
            if isinstance(result, str):
                return result
            result.quit()
            return "ok"

        def done(result, error):
            self._set_form_busy(False)
            if error is not None:
                self._set_form_status(f"Something went wrong while checking your login: {error}")
            elif result == "wrong":
                self._set_form_status("Wrong Gmail or App Password. Try again.")
            elif result == "offline":
                self._set_form_status("Could not reach Gmail. Check your internet, then try again.")
            else:
                self._begin(name, email, app_password, login_ok=True)

        self.run_in_background(work, done)

    def _begin(self, name, email, app_password, login_ok=False, oauth=False):
        self.quest.player = name
        self.quest.email = email
        self.quest.app_password = app_password
        self.build_shell()
        self.show_dashboard()
        if login_ok:
            self.toast("Login OK! Your certificate PDF will be emailed when you pass all 7 lessons.", "success")
        elif oauth:
            self.toast("Your certificate PDF will be sent with Google sign-in (OAuth) when you click Send.", "info")
        self.toast(f"Welcome, {name}! Choose any lesson you like.", "info")

