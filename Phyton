    def toast(self, message, kind="info", duration=4200):
        palette = {
            "info": (C["primary_soft"], C["primary"], C["primary_text"]),
            "success": (C["success_soft"], C["success"], C["output"]),
            "error": (C["error_soft"], C["error"], C["error"]),
        }
        bg, border, color = palette[kind]
        frame = ctk.CTkFrame(self, fg_color=bg, corner_radius=12, border_width=1, border_color=border)
        ctk.CTkLabel(frame, text=message, wraplength=340, justify="left", anchor="w",
                     font=self.font(13, "bold"), text_color=color).pack(padx=16, pady=12)
        self._toasts.append(frame)
        while len(self._toasts) > 3:
            oldest = self._toasts.pop(0)
            oldest.destroy()
        self._layout_toasts()
        frame.lift()
        self.after(duration, lambda: self._dismiss_toast(frame))

    def _layout_toasts(self):
        y = 22
        scale = self._scaling()
        for frame in self._toasts:
            frame.place(relx=1.0, x=-22, y=y, anchor="ne")
            frame.update_idletasks()
            y += frame.winfo_reqheight() / scale + 10

    def _dismiss_toast(self, frame):
        if frame in self._toasts:
            self._toasts.remove(frame)
            frame.destroy()
            self._layout_toasts()

