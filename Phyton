    def show_quiz(self, index):
        lesson = LESSONS[index]
        self._show_page(f"lesson-{index}", f"Lesson {index + 1} Quiz", lesson["title"],
                        lambda page: self._build_quiz(page, index))

    def _build_quiz(self, page, index):
        lesson = LESSONS[index]
        questions = lesson["quiz"]
        self.quiz_items = []
        self.quiz_done = False

        intro = self._card(page, fg=C["surface"], radius=18)
        intro.pack(fill="x", pady=(0, 8))
        intro_inner = ctk.CTkFrame(intro, fg_color="transparent")
        intro_inner.pack(fill="x", padx=24, pady=18)
        ctk.CTkLabel(intro_inner, text=f"LESSON {index + 1} QUIZ", font=self.font(11, "bold"),
                     text_color=C["accent"], height=16, anchor="w").pack(anchor="w")
        self._text(intro_inner, f"Answer all {len(questions)} questions. You need a perfect score "
                                f"({len(questions)} out of {len(questions)}) to pass the lesson and earn the badge.",
                   14, color=C["text_soft"], inset=210).pack(anchor="w", fill="x", pady=(4, 0))
        if lesson.get("quiz_note"):
            ctk.CTkLabel(intro_inner, text=f"Note: {lesson['quiz_note']}", font=self.font(13, "bold"),
                         text_color=C["primary_text"], anchor="w").pack(anchor="w", pady=(8, 0))

        for number, question in enumerate(questions, start=1):
            card = self._card(page, radius=16)
            card.pack(fill="x", pady=8)
            inner = ctk.CTkFrame(card, fg_color="transparent")
            inner.pack(fill="x", padx=24, pady=20)
            ctk.CTkLabel(inner, text=f"QUESTION {number} OF {len(questions)}", font=self.font(10, "bold"),
                         text_color=C["muted"], height=14, anchor="w").pack(anchor="w")
            self._text(inner, question["prompt"], 15, "bold", inset=230).pack(anchor="w", fill="x", pady=(4, 0))
            if question.get("code"):
                ctk.CTkLabel(inner, text=f"  {question['code']}  ", font=self.font(14, kind="mono"),
                             fg_color=C["code_bg"], corner_radius=8, text_color=C["primary_text"],
                             height=34).pack(anchor="w", pady=(10, 0))

            if question.get("options"):
                variable = ctk.StringVar(value="")
                widgets = []
                for option_number, option_text in enumerate(question["options"], start=1):
                    radio = ctk.CTkRadioButton(
                        inner, text=option_text, variable=variable, value=str(option_number),
                        font=self.font(14), text_color=C["text_soft"], fg_color=C["primary"],
                        hover_color=C["primary_hover"], border_color=C["muted"],
                        text_color_disabled=C["muted"])
                    radio.pack(anchor="w", pady=(10 if option_number == 1 else 4, 4))
                    widgets.append(radio)
                getter = variable.get
            else:
                entry = self._entry(inner, question.get("placeholder", "Type your answer"), width=340)
                entry.pack(anchor="w", pady=(12, 0))
                entry.bind("<Return>", lambda _e: self._submit_quiz(index))
                widgets = [entry]
                getter = entry.get

            self.quiz_items.append({"card": card, "inner": inner, "get": getter,
                                    "widgets": widgets, "question": question})

        self.quiz_footer = ctk.CTkFrame(page, fg_color="transparent")
        self.quiz_footer.pack(fill="x", pady=(12, 0))
        ctk.CTkLabel(self.quiz_footer, text="You can retake the quiz as many times as you like.",
                     font=self.font(12), text_color=C["muted"]).pack(side="left")
        self._button(self.quiz_footer, "Submit Answers", lambda: self._submit_quiz(index),
                     width=170, height=44).pack(side="right")
        self._button(self.quiz_footer, "Back to Lesson", lambda: self.show_lesson(index),
                     "ghost", width=150, height=44).pack(side="right", padx=10)

    def _submit_quiz(self, index):
        if self.quiz_done:
            return
        missing = 0
        for item in self.quiz_items:
            unanswered = item["get"]().strip() == ""
            missing += unanswered
            item["card"].configure(border_color=C["error"] if unanswered else C["border"])
        if missing:
            self.toast(f"Please answer every question first ({missing} left).", "error")
            return

        self.quiz_done = True
        score = 0
        for item in self.quiz_items:
            question = item["question"]
            correct = item["get"]().strip() in question["answer"]
            score += correct
            if correct:
                message = "✓  Correct!"
            else:
                message = "✗  Wrong." + (f" Hint: {question['hint']}" if question.get("hint") else "")
            feedback = self._text(item["inner"], message, 13, "bold", inset=260,
                                  color=C["success"] if correct else C["error"],
                                  fg_color=C["success_soft"] if correct else C["error_soft"],
                                  corner_radius=8)
            feedback.pack(anchor="w", fill="x", pady=(14, 0), ipadx=10, ipady=4)
            item["card"].configure(border_color=C["success"] if correct else C["error"])
            for widget in item["widgets"]:
                widget.configure(state="disabled")

        self._show_quiz_result(index, score, len(self.quiz_items))
        self.after(20, lambda: self._update_wrap(self.body.winfo_width()))

    def _show_quiz_result(self, index, score, total):
        for child in self.quiz_footer.winfo_children():
            child.destroy()

        perfect = score == total
        card = self._card(self.quiz_footer, fg=C["success_soft"] if perfect else C["surface"],
                          border=C["success"] if perfect else C["border"], radius=18)
        card.pack(fill="x")
        inner = ctk.CTkFrame(card, fg_color="transparent")
        inner.pack(fill="x", padx=26, pady=22)
        inner.grid_columnconfigure(1, weight=1)

        ctk.CTkLabel(inner, text=f"{score}/{total}", font=self.font(40, "bold"),
                     text_color=C["success"] if perfect else C["accent"]).grid(
            row=0, column=0, rowspan=2, sticky="w", padx=(0, 24))

        buttons = ctk.CTkFrame(inner, fg_color="transparent")
        buttons.grid(row=2, column=0, columnspan=2, sticky="w", pady=(16, 0))

        if perfect:
            old_rank = self.quest.rank
            newly_passed = self.quest.mark_passed(index)
            title = f"PERFECT! Lesson {index + 1} passed. Badge earned!"
            detail = f"Score: {score} out of {total}. You have passed {self.quest.passed} of 7 lessons."
            if not newly_passed:
                detail += " (You already had this badge — great review!)"
            self._button(buttons, "Back to Menu", self.show_dashboard, "ghost", width=150).pack(side="left", padx=(0, 10))
            next_index = self.quest.next_unpassed(index + 1)
            if next_index is None:
                self._button(buttons, "View Certificate", self.show_certificate, "accent", width=180).pack(side="left")
            else:
                self._button(buttons, f"Next: Lesson {next_index + 1}",
                             lambda: self.show_lesson(next_index), width=180).pack(side="left")
            self.refresh_chrome()
            if self.quest.rank != old_rank:
                self.toast(f"Rank up! You are now a {self.quest.rank}.", "success")
            self.check_auto_certificate()
        else:
            title = f"Score: {score} out of {total}"
            detail = "Not perfect yet. What do you want to do?"
            self._button(buttons, "Retake the Quiz", lambda: self.show_quiz(index), width=160).pack(side="left", padx=(0, 10))
            self._button(buttons, "Review the Lesson", lambda: self.show_lesson(index), "ghost", width=170).pack(side="left", padx=(0, 10))
            self._button(buttons, "Back to Menu", self.show_dashboard, "ghost", width=150).pack(side="left")

        self._text(inner, title, 18, "bold", inset=330,
                   color=C["success"] if perfect else C["text"]).grid(row=0, column=1, sticky="sw")
        self._text(inner, detail, 13, color=C["text_soft"], inset=330).grid(row=1, column=1, sticky="nw")
        self.after(80, self._scroll_to_bottom)

    # ---------------------------------------------------------------
    #  Certificate: PDF, save, preview, delivery
    # ---------------------------------------------------------------

    def get_pdf(self):
        """Return the certificate PDF bytes, regenerating only when the certificate data changed."""
        quest = self.quest
        key = (quest.player, quest.rank, quest.passed, datetime.date.today().isoformat())
        if self._pdf_cache is None or self._pdf_cache[0] != key:
            data = build_certificate_pdf(quest.player, quest.rank, quest.passed, TOTAL_LESSONS)
            self._pdf_cache = (key, data)
            quest.pdf_generated = True
        return self._pdf_cache[1]

    def check_auto_certificate(self):
        """Original behaviour: with an App Password, send automatically after the 7th lesson.
        With OAuth the user clicks 'Send via Gmail' so the Google sign-in window never surprises them."""
        quest = self.quest
        if (quest.passed == TOTAL_LESSONS and quest.email != "" and quest.app_password != ""
                and not quest.cert_sent and not self.sending):
            self.toast(f"You passed ALL lessons! Sending your certificate PDF to {quest.email} ...", "info")
            self.send_certificate_async()

    def send_certificate_async(self):
        quest = self.quest
        if self.sending or not quest.email:
            return
        try:
            pdf_bytes = self.get_pdf()
        except Exception as exc:
            quest.last_error = f"Could not generate the PDF ({exc})"
            self.toast(quest.last_error, "error", 6000)
            self._render_cert_actions()
            return
        filename = certificate_filename(quest.player)

        secret_path = None
        if not quest.app_password:
            secret_path = find_client_secret()
            if secret_path is None:
                messagebox.showinfo(
                    "Google sign-in setup",
                    "To send through the Gmail API you need an OAuth client file (credentials.json) "
                    "from Google Cloud Console (Desktop app type, Gmail API enabled).\n\n"
                    "Choose that file in the next window. A private copy is kept in:\n"
                    f"{CONFIG_DIR}")
                chosen = filedialog.askopenfilename(title="Select your Google OAuth credentials.json",
                                                    filetypes=[("JSON file", "*.json"), ("All files", "*.*")])
                if not chosen:
                    quest.last_error = "No credentials.json selected, so the email was not sent."
                    self._render_cert_actions()
                    return
                try:
                    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
                    shutil.copyfile(chosen, CLIENT_SECRET_FILE)
                    try:
                        os.chmod(CLIENT_SECRET_FILE, 0o600)
                    except OSError:
                        pass
                    secret_path = str(CLIENT_SECRET_FILE)
                except OSError:
                    secret_path = chosen

        self.sending = True
        quest.last_error = None
        self._render_cert_actions()
        if secret_path:
            self.toast("A Google sign-in window may open in your browser. Approve it to send.", "info", 6000)

        def work():
            if quest.app_password:
                return send_certificate(quest.email, quest.app_password, quest.player, pdf_bytes, filename)
            return gmail_api_send(quest.email, quest.player, pdf_bytes, filename, secret_path)

        def done(result, error):
            self.sending = False
            if error is not None:
                sent, message = False, f"Something went wrong: {error}"
            else:
                sent, message = result
            if sent:
                quest.cert_sent = True
                quest.last_error = None
                self.toast(message, "success")
            else:
                quest.last_error = message
                self.toast(f"{message} Not sent. You can try again from the Certificate page.", "error", 7000)
            self._render_cert_actions()
            if self.current_key == "dashboard":
                self.show_dashboard()

        self.run_in_background(work, done)

    def show_certificate(self):
        unlocked = self.quest.passed == TOTAL_LESSONS
        subtitle = ("Officially certified as a PYTHON MASTER." if unlocked
                    else "Unlocked after all 7 lessons are passed.")
        self._show_page("certificate", "Your Certificate", subtitle, self._build_certificate)
        if (unlocked and self.quest.email and self.quest.app_password
                and not self.quest.cert_sent and not self.sending):
            self.toast(f"Sending PDF to {self.quest.email} ...", "info")
            self.send_certificate_async()

    def _build_certificate(self, page):
        self.cert_actions = None
        if self.quest.passed < TOTAL_LESSONS:
            self._build_locked_certificate(page)
            return

        # Generate the PDF up front so "PDF Generated" is accurate and errors show early.
        pdf_error = None
        try:
            self.get_pdf()
        except Exception as exc:
            pdf_error = str(exc)
            self.quest.pdf_generated = False

        player = self.quest.player
        frame = ctk.CTkFrame(page, fg_color=C["cert_gold"], corner_radius=22)
        frame.pack(fill="x")
        paper = ctk.CTkFrame(frame, fg_color=C["cert_bg"], corner_radius=18)
        paper.pack(fill="both", padx=5, pady=5)
        border = ctk.CTkFrame(paper, fg_color="transparent", border_width=1,
                              border_color=C["cert_gold"], corner_radius=14)
        border.pack(fill="both", padx=16, pady=16)
        content = ctk.CTkFrame(border, fg_color="transparent")
        content.pack(fill="both", padx=44, pady=34)

        ctk.CTkLabel(content, text="ACT102  ·  PYTHON QUEST", font=self.font(11, "bold"),
                     text_color=C["cert_gold"]).pack()
        ctk.CTkLabel(content, text="CERTIFICATE OF COMPLETION", font=self.font(28, "bold", "serif"),
                     text_color=C["cert_text"]).pack(pady=(8, 0))
        ctk.CTkLabel(content, text="Proudly presented to", font=self.font(14, kind="serif", slant="italic"),
                     text_color="#6B7280").pack(pady=(14, 0))
        self._text(content, player, 34, "bold", kind="serif", color=C["cert_name"], inset=260,
                   justify="center", anchor="center").pack(pady=(2, 6))
        ctk.CTkFrame(content, fg_color=C["cert_gold"], height=2, width=240).pack(pady=(0, 18))

        for paragraph in certificate_paragraphs(player):
            self._text(content, paragraph, 14, kind="serif", color="#374151", inset=300,
                       justify="center", anchor="center").pack(fill="x", pady=6)

        footer = ctk.CTkFrame(content, fg_color="transparent")
        footer.pack(fill="x", pady=(24, 0))
        footer.grid_columnconfigure((0, 1, 2), weight=1, uniform="cert")
        # The same helper feeds the PDF, so preview and PDF always agree.
        for column, (caption, value) in enumerate(
                certificate_details(self.quest.rank, self.quest.passed, TOTAL_LESSONS)):
            cell = ctk.CTkFrame(footer, fg_color="transparent")
            cell.grid(row=0, column=column)
            ctk.CTkLabel(cell, text=caption, font=self.font(10, "bold"), text_color=C["cert_gold"],
                         height=14).pack()
            ctk.CTkLabel(cell, text=value, font=self.font(14, "bold", "serif"),
                         text_color=C["cert_text"]).pack()

        self.cert_actions = self._card(page, radius=18)
        self.cert_actions.pack(fill="x", pady=(16, 0))
        self._render_cert_actions(pdf_error=pdf_error)

    def _render_cert_actions(self, pdf_error=None):
        holder = self.cert_actions
        if holder is None or not holder.winfo_exists():
            return
        for child in holder.winfo_children():
            child.destroy()

        quest = self.quest
        holder.grid_columnconfigure(0, weight=1)

        ctk.CTkLabel(holder, text="Delivery", font=self.font(16, "bold"), text_color=C["text"],
                     height=22, anchor="w").grid(row=0, column=0, sticky="w", padx=24, pady=(18, 4))

        # --- status text ---
        if pdf_error:
            status, color = f"PDF problem: {pdf_error}", C["error"]
        elif not quest.email:
            status, color = ("You played without email. Save the PDF or copy your certificate instead.",
                             C["muted"])
        elif self.sending:
            status, color = f"Sending the PDF to {quest.email} ...", C["primary_text"]
        elif quest.cert_sent:
            status, color = (f"Certificate PDF sent to {quest.email}! Check your inbox (and the Spam folder).",
                             C["success"])
        elif quest.last_error:
            status, color = f"{quest.last_error} Not sent yet.", C["error"]
        elif quest.app_password:
            status, color = f"Not sent yet. Click Send via Gmail to email the PDF to {quest.email}.", C["muted"]
        else:
            status, color = (f"Not sent yet. Click Send via Gmail to sign in with Google and email the PDF "
                             f"to {quest.email}.", C["muted"])
        self._text(holder, status, 13, color=color, inset=120).grid(
            row=1, column=0, sticky="ew", padx=24, pady=(0, 10))

        # --- status chips: green on success, red on error ---
        chips = ctk.CTkFrame(holder, fg_color="transparent")
        chips.grid(row=2, column=0, sticky="w", padx=24, pady=(0, 12))

        if pdf_error:
            self._pill(chips, "✗ PDF FAILED", C["error_soft"], C["error"]).pack(side="left", padx=(0, 8))
        elif quest.pdf_generated:
            self._pill(chips, "✓ PDF GENERATED", C["success_soft"], C["success"]).pack(side="left", padx=(0, 8))
        else:
            self._pill(chips, "PDF GENERATED", C["primary_soft"], C["muted"]).pack(side="left", padx=(0, 8))

        if quest.pdf_saved:
            self._pill(chips, "✓ PDF SAVED", C["success_soft"], C["success"]).pack(side="left", padx=(0, 8))
        else:
            self._pill(chips, "PDF SAVED", C["primary_soft"], C["muted"]).pack(side="left", padx=(0, 8))

        if quest.cert_sent:
            self._pill(chips, "✓ EMAIL SENT", C["success_soft"], C["success"]).pack(side="left")
        elif quest.last_error and quest.email and not self.sending:
            self._pill(chips, "✗ EMAIL FAILED", C["error_soft"], C["error"]).pack(side="left")
        elif self.sending:
            self._pill(chips, "SENDING...", C["primary_soft"], C["primary_text"]).pack(side="left")
        else:
            self._pill(chips, "EMAIL SENT", C["primary_soft"], C["muted"]).pack(side="left")

        # --- buttons: Preview, Save as PDF, Copy text, Send via Gmail ---
        buttons = ctk.CTkFrame(holder, fg_color="transparent")
        buttons.grid(row=3, column=0, sticky="w", padx=24, pady=(0, 18))
        self._button(buttons, "Preview Certificate", self._preview_certificate, "ghost", width=170).pack(
            side="left", padx=(0, 8))
        self._button(buttons, "Save as PDF", self._save_pdf, "primary", width=130).pack(side="left", padx=(0, 8))
        self._button(buttons, "Copy Certificate Text", self._copy_certificate, "ghost", width=190).pack(
            side="left", padx=(0, 8))
        if quest.email:
            if self.sending:
                send = self._button(buttons, "Sending...", None, width=160)
                send.configure(state="disabled")
            elif quest.cert_sent:
                send = self._button(buttons, "Sent ✓", None, width=160)
                send.configure(state="disabled", fg_color=C["success_soft"], text_color_disabled=C["success"])
            else:
                send = self._button(buttons, "Send via Gmail", self.send_certificate_async, "accent", width=160)
            send.pack(side="left", padx=(0, 8))
        self._button(buttons, "Save as .txt", self._save_certificate, "ghost", width=120).pack(side="left")

        self.after(10, lambda: self._update_wrap(self.body.winfo_width()))

    def _preview_certificate(self):
        """Open the real PDF in the system viewer so the user sees exactly what will be saved/sent."""
        try:
            data = self.get_pdf()
            if self._temp_preview is None:
                handle = tempfile.NamedTemporaryFile(prefix="python_journey_preview_", suffix=".pdf",
                                                     delete=False)
                handle.close()
                self._temp_preview = handle.name
            with open(self._temp_preview, "wb") as out:
                out.write(data)
            webbrowser.open(Path(self._temp_preview).as_uri())
            self.toast("Opening the certificate PDF preview...", "info")
        except Exception as exc:
            self.quest.pdf_generated = False
            self.toast(f"Could not create the preview: {exc}", "error", 6000)
        self._render_cert_actions()

    def _save_pdf(self):
        quest = self.quest
        try:
            data = self.get_pdf()
        except Exception as exc:
            self.toast(f"Could not generate the PDF: {exc}", "error", 6000)
            self._render_cert_actions(pdf_error=str(exc))
            return
        path = filedialog.asksaveasfilename(
            title="Save certificate as PDF", defaultextension=".pdf",
            initialfile=certificate_filename(quest.player),
            filetypes=[("PDF document", "*.pdf"), ("All files", "*.*")])
        if not path:
            return
        try:
            with open(path, "wb") as handle:
                handle.write(data)
        except OSError as exc:
            self.toast(f"Could not save the PDF: {exc}", "error", 6000)
            messagebox.showerror("Could not save", f"The PDF could not be saved:\n{exc}")
            return
        quest.pdf_saved = True
        self.toast(f"PDF saved: {Path(path).name}", "success")
        self._render_cert_actions()

    def _copy_certificate(self):
        self.clipboard_clear()
        self.clipboard_append(certificate_text(self.quest.player))
        self.toast("Certificate text copied to the clipboard.", "success")

    def _save_certificate(self):
        safe_name = "".join(ch for ch in self.quest.player if ch.isalnum() or ch in " _-").strip() or "player"
        path = filedialog.asksaveasfilename(
            title="Save certificate", defaultextension=".txt",
            initialfile=f"{safe_name.replace(' ', '_')}_Python_Certificate.txt",
            filetypes=[("Text file", "*.txt"), ("All files", "*.*")])
        if not path:
            return
        try:
            with open(path, "w", encoding="utf-8") as handle:
                handle.write(certificate_text(self.quest.player))
        except OSError as exc:
            messagebox.showerror("Could not save", f"The certificate could not be saved:\n{exc}")
            return
        self.toast("Certificate saved.", "success")

    def _build_locked_certificate(self, page):
        left = TOTAL_LESSONS - self.quest.passed
        card = self._card(page, radius=20)
        card.pack(fill="x")
        inner = ctk.CTkFrame(card, fg_color="transparent")
        inner.pack(fill="x", padx=30, pady=28)

        ctk.CTkLabel(inner, text="★", width=56, height=56, corner_radius=16, fg_color=C["primary_soft"],
                     text_color=C["accent"], font=self.font(26, "bold")).pack(anchor="w")
        ctk.CTkLabel(inner, text="Certificate locked", font=self.font(22, "bold"),
                     text_color=C["text"], anchor="w").pack(anchor="w", pady=(14, 0))
        self._text(inner, f"Not yet! Pass {left} more lesson(s) to unlock your certificate.",
                   14, color=C["text_soft"], inset=220).pack(anchor="w", fill="x")
        bar = ctk.CTkProgressBar(inner, height=10, corner_radius=5, fg_color=C["border"],
                                 progress_color=C["success"])
        bar.set(self.quest.passed / TOTAL_LESSONS)
        bar.pack(fill="x", pady=(16, 20))

        for index, lesson in enumerate(LESSONS):
            passed = self.quest.is_passed(index)
            row = ctk.CTkFrame(inner, fg_color=C["surface"], corner_radius=12)
            row.pack(fill="x", pady=4)
            ctk.CTkLabel(row, text="✓" if passed else str(index + 1), width=30, height=30, corner_radius=8,
                         fg_color=C["success_soft"] if passed else C["primary_soft"],
                         text_color=C["success"] if passed else C["primary_text"],
                         font=self.font(13, "bold")).pack(side="left", padx=12, pady=8)
            ctk.CTkLabel(row, text=lesson["title"], font=self.font(14, "bold" if not passed else "normal"),
                         text_color=C["muted"] if passed else C["text"]).pack(side="left")
            if passed:
                self._pill(row, "✓ PASSED", C["success_soft"], C["success"]).pack(side="right", padx=14)
            else:
                self._button(row, "Open", lambda i=index: self.show_lesson(i), "ghost",
                             width=84, height=30).pack(side="right", padx=12)

    # ---------------------------------------------------------------
    #  Exit
    # ---------------------------------------------------------------

    def on_exit(self):
        if self.sending:
            if not messagebox.askyesno("Email still sending",
                                       "Your certificate is still being sent. Exit anyway?"):
                return
        elif not messagebox.askyesno("Exit Python Journey", "Are you sure you want to exit?"):
            return
        if self.quest.player:
            messagebox.showinfo("Goodbye",
                                f"Goodbye, {self.quest.player}! You passed {self.quest.passed} of 7 "
                                f"lessons. Rank: {self.quest.rank}")
        if self._temp_preview:
            try:
                os.remove(self._temp_preview)
            except OSError:
                pass
        self.destroy()


def main():
    app = PythonJourneyApp()
    app.mainloop()


if __name__ == "__main__":
    main()
