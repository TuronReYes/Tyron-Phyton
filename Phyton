    def show_dashboard(self):
        self._show_page("dashboard", f"Welcome, {self.quest.player}!",
                        "Choose any lesson you like.", self._build_dashboard)

    def _build_dashboard(self, page):
        quest = self.quest
        next_index = quest.next_unpassed()

        hero = self._card(page, fg=C["surface"], radius=20)
        hero.pack(fill="x")
        hero.grid_columnconfigure(0, weight=1)
        left = ctk.CTkFrame(hero, fg_color="transparent")
        left.grid(row=0, column=0, sticky="nsew", padx=28, pady=26)

        if next_index is None:
            eyebrow, heading = "QUEST COMPLETE", "You conquered every lesson!"
            detail = "Your Python Master certificate is unlocked and waiting for you."
            action = self._button(left, "View Certificate", self.show_certificate, "accent", width=200)
        else:
            eyebrow = "UP NEXT"
            heading = f"Lesson {next_index + 1}: {LESSONS[next_index]['title']}"
            detail = (LESSONS[next_index]["summary"] + " Get a perfect quiz score to earn the badge.")
            label = "Start Lesson" if quest.passed == 0 else "Continue Journey"
            action = self._button(left, label, lambda: self.show_lesson(next_index), width=200)

        ctk.CTkLabel(left, text=eyebrow, font=self.font(11, "bold"), text_color=C["accent"],
                     height=16, anchor="w").pack(anchor="w")
        self._text(left, heading, 22, "bold", inset=380).pack(anchor="w", fill="x", pady=(6, 4))
        self._text(left, detail, 14, color=C["muted"], inset=380).pack(anchor="w", fill="x", pady=(0, 18))
        action.pack(anchor="w")

        right = ctk.CTkFrame(hero, fg_color="transparent")
        right.grid(row=0, column=1, sticky="e", padx=32, pady=26)
        ctk.CTkLabel(right, text=f"{quest.passed}/{TOTAL_LESSONS}", font=self.font(46, "bold"),
                     text_color=C["text"]).pack()
        ctk.CTkLabel(right, text="LESSONS PASSED", font=self.font(11, "bold"),
                     text_color=C["muted"], height=16).pack()

        stats = ctk.CTkFrame(page, fg_color="transparent")
        stats.pack(fill="x", pady=(16, 0))
        stats.grid_columnconfigure((0, 1, 2), weight=1, uniform="stats")

        if quest.passed < 4:
            rank_detail = f"{4 - quest.passed} more lesson(s) to reach Coder"
        elif quest.passed < 7:
            rank_detail = f"{7 - quest.passed} more lesson(s) to reach Python Master"
        else:
            rank_detail = "Highest rank achieved"

        if quest.passed < TOTAL_LESSONS:
            cert_value, cert_detail = "Locked", "Pass all 7 lessons to unlock"
        elif quest.cert_sent:
            cert_value, cert_detail = "Emailed", f"Sent to {quest.email}"
        else:
            cert_value, cert_detail = "Unlocked", "Open it from the sidebar"

        cards = [
            ("LESSONS PASSED", f"{quest.passed} of {TOTAL_LESSONS}",
             "All complete" if quest.passed == TOTAL_LESSONS else f"{TOTAL_LESSONS - quest.passed} remaining",
             C["text"]),
            ("CURRENT RANK", quest.rank, rank_detail, C["accent"]),
            ("CERTIFICATE", cert_value, cert_detail,
             C["success"] if quest.passed == TOTAL_LESSONS else C["text"]),
        ]
        for column, (caption, value, detail, color) in enumerate(cards):
            card = self._card(stats, radius=16)
            card.grid(row=0, column=column, sticky="nsew",
                      padx=(0 if column == 0 else 8, 0 if column == 2 else 8))
            inner = ctk.CTkFrame(card, fg_color="transparent")
            inner.pack(fill="both", padx=20, pady=16)
            ctk.CTkLabel(inner, text=caption, font=self.font(10, "bold"), text_color=C["muted"],
                         height=14, anchor="w").pack(anchor="w")
            ctk.CTkLabel(inner, text=value, font=self.font(20, "bold"), text_color=color,
                         height=30, anchor="w").pack(anchor="w", pady=(4, 0))
            self._text(inner, detail, 12, color=C["muted"], inset=160, columns=3).pack(anchor="w", fill="x")

        ctk.CTkLabel(page, text="All lessons", font=self.font(17, "bold"), text_color=C["text"],
                     anchor="w").pack(anchor="w", pady=(24, 4))

        grid = ctk.CTkFrame(page, fg_color="transparent")
        grid.pack(fill="x")
        grid.grid_columnconfigure((0, 1), weight=1, uniform="lessons")
        for index, lesson in enumerate(LESSONS):
            self._lesson_card(grid, index, lesson).grid(
                row=index // 2, column=index % 2, sticky="nsew",
                padx=(0, 8) if index % 2 == 0 else (8, 0), pady=8)

    def _lesson_card(self, parent, index, lesson):
        passed = self.quest.is_passed(index)
        card = self._card(parent, border=C["success"] if passed else None)
        inner = ctk.CTkFrame(card, fg_color="transparent")
        inner.pack(fill="both", expand=True, padx=20, pady=18)

        top = ctk.CTkFrame(inner, fg_color="transparent")
        top.pack(fill="x")
        ctk.CTkLabel(top, text="✓" if passed else str(index + 1), width=38, height=38, corner_radius=10,
                     fg_color=C["success_soft"] if passed else C["primary_soft"],
                     text_color=C["success"] if passed else C["primary_text"],
                     font=self.font(15, "bold")).pack(side="left")
        self._status_pill(top, index).pack(side="right")

        ctk.CTkLabel(inner, text=lesson["title"], font=self.font(16, "bold"), text_color=C["text"],
                     anchor="w").pack(anchor="w", fill="x", pady=(12, 0))
