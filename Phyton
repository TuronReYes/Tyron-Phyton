TOTAL_LESSONS = len(LESSONS)


# =====================================================================
#  STATE
# =====================================================================

class QuestState:
    def __init__(self):
        self.player = ""
        self.email = ""
        self.app_password = ""
        self.cert_sent = False
        self.pdf_generated = False
        self.pdf_saved = False
        self.last_error = None
        self.passed_lessons = set()

    @property
    def passed(self):
        return len(self.passed_lessons)

    @property
    def rank(self):
        if self.passed == 7:
            return "Python Master"
        elif self.passed >= 4:
            return "Coder"
        return "Newbie"

    def is_passed(self, index):
        return index in self.passed_lessons

    def mark_passed(self, index):
        newly_passed = index not in self.passed_lessons
        self.passed_lessons.add(index)
        return newly_passed

    def next_unpassed(self, start=0):
        for offset in range(TOTAL_LESSONS):
            index = (start + offset) % TOTAL_LESSONS
            if index not in self.passed_lessons:
                return index
        return None


